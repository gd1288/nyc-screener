# Copy to .env and fill in. All keys are free.
# NYC Open Data app token: https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=
# US Census API key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# NYC Geoclient key: https://api-portal.nyc.gov
NYC_GEOCLIENT_KEY=
# RentCast (free tier): https://app.rentcast.io/app/api
RENTCAST_API_KEY=

DATABASE_URL=sqlite:///./data/screener.db
